{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "rewrites": [
    { 
      "source": "/api/:path*",
      "destination": "https://studdy-buddy-backend-a5x.onrender.com/api/:path*"
    },
    { 
      "source": "/((?!api).*)",
      "destination": "/" 
    }
  ]
}
