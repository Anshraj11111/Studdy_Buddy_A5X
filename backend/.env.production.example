# ═══════════════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT VARIABLES (10K USERS OPTIMIZED)
# ═══════════════════════════════════════════════════════════════════════════
# Copy this to .env on each Render server

PORT=5000
NODE_ENV=production

# ═══════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION (MULTI-DB MODE FOR 10K USERS)
# ═══════════════════════════════════════════════════════════════════════════

# PRIMARY Database: Users, Auth, Communities, Connections (High-frequency queries)
MONGO_URI_PRIMARY=mongodb+srv://studdybuddy:Anshraj0001@cluster0.j1irlmw.mongodb.net/studdy-buddy?retryWrites=true&w=majority&appName=Cluster0

# SECONDARY Database: Doubts, Resources, Playlists, Posts (Medium-frequency content)
MONGO_URI_SECONDARY=mongodb+srv://cofoundera5x_db_user:O9kmwJa72kvotxwU@cluster0.m9gye1i.mongodb.net/studdy-buddy?retryWrites=true&w=majority

# TERTIARY Database: Messages, Notifications, Broadcasts, Rooms (High-volume real-time)
MONGO_URI_TERTIARY=mongodb+srv://supporta5x_db_user:nRc8MALAnk3UWvwa@cluster0.ycyqhgu.mongodb.net/studdy-buddy?retryWrites=true&w=majority

# Fallback (if multi-DB not enabled)
MONGO_URI=mongodb+srv://studdybuddy:Anshraj0001@cluster0.j1irlmw.mongodb.net/studdy-buddy?retryWrites=true&w=majority&appName=Cluster0

# ═══════════════════════════════════════════════════════════════════════════
# REDIS CONFIGURATION (OPTIONAL BUT RECOMMENDED FOR 10K USERS)
# ═══════════════════════════════════════════════════════════════════════════
# Use FREE Redis hosting:
# - Upstash: https://upstash.com (10K commands/day FREE)
# - Redis Cloud: https://redis.com (30MB FREE)
# - Railway: https://railway.app (100MB FREE)

# Example Upstash Redis URL:
# REDIS_URL=rediss://default:xxxxxxx@awesome-raccoon-12345.upstash.io:6379

# Local development:
# REDIS_URL=redis://localhost:6379

# Leave empty if not using Redis (app will work without it, just slower)
REDIS_URL=

# ═══════════════════════════════════════════════════════════════════════════
# AUTHENTICATION & SECURITY
# ═══════════════════════════════════════════════════════════════════════════

JWT_SECRET=studdybuddysecret
JWT_EXPIRE=30d
BCRYPT_ROUNDS=10

# Admin Panel secret — typed at runtime on the login screen, never compiled into client JS.
# Change this to something strong before going to production.
ADMIN_SECRET=change-this-to-a-strong-secret

# Mentor Code
MENTOR_CODE=H5

# ═══════════════════════════════════════════════════════════════════════════
# CORS CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Production frontend URLs (comma-separated if multiple)
CORS_ORIGIN=https://studdy-buddy-a5x.vercel.app

# ═══════════════════════════════════════════════════════════════════════════
# RATE LIMITING (OPTIMIZED FOR 10K USERS)
# ═══════════════════════════════════════════════════════════════════════════

# General API rate limit
RATE_LIMIT_WINDOW_MS=900000           # 15 minutes
RATE_LIMIT_MAX_REQUESTS=200           # 200 requests per 15 min per IP

# Auth endpoints rate limit (stricter)
AUTH_RATE_LIMIT_WINDOW_MS=900000      # 15 minutes
AUTH_RATE_LIMIT_MAX_REQUESTS=10       # 10 login attempts per 15 min

# ═══════════════════════════════════════════════════════════════════════════
# GOOGLE OAUTH
# ═══════════════════════════════════════════════════════════════════════════

GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ═══════════════════════════════════════════════════════════════════════════
# CLOUDINARY (IMAGE/VIDEO STORAGE)
# ═══════════════════════════════════════════════════════════════════════════

CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ═══════════════════════════════════════════════════════════════════════════
# AI INTEGRATION (GEMINI)
# ═══════════════════════════════════════════════════════════════════════════

GEMINI_API_KEY=your-gemini-api-key

# OpenRouter (Multi-model AI - Optional)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.5-flash

# ═══════════════════════════════════════════════════════════════════════════
# EMAIL CONFIGURATION (PASSWORD RESET, NOTIFICATIONS)
# ═══════════════════════════════════════════════════════════════════════════

# SMTP Settings (Gmail, Outlook, or Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# Email From Name
EMAIL_FROM_NAME=Studdy Buddy

# Gmail Setup Instructions:
# 1. Enable 2-factor authentication on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate an "App Password" for "Mail"
# 4. Use that password in SMTP_PASS above

# Outlook/Hotmail Setup:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=your-email@outlook.com
# SMTP_PASS=your-password

# Custom SMTP (e.g., SendGrid, AWS SES):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# ═══════════════════════════════════════════════════════════════════════════
# WEBRTC (VIDEO CALLS) - TURN SERVERS
# ═══════════════════════════════════════════════════════════════════════════

# Cloudflare TURN (Primary)
CF_ACCOUNT_ID=your-cf-account-id
CF_TURN_KEY_ID=your-turn-key-id
CF_API_TOKEN=your-cf-api-token
CF_EMAIL=your-email@example.com
CF_GLOBAL_KEY=your-cf-global-key
CF_TURN_SECRET=your-turn-secret

# Metered TURN (Fallback)
METERED_APP_NAME=studdybuddy
METERED_API_KEY=7d27bc68c8e5c1566fee9fe7b48ebce29551

# ═══════════════════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ═══════════════════════════════════════════════════════════════════════════

APP_URL=https://studdy-buddy-a5x.vercel.app

# ═══════════════════════════════════════════════════════════════════════════
# PERFORMANCE TUNING (10K USERS OPTIMIZED)
# ═══════════════════════════════════════════════════════════════════════════

# Node.js Memory Limit (for Render FREE tier - 512MB)
NODE_OPTIONS=--max-old-space-size=460

# Enable compression
COMPRESSION_ENABLED=true

# Enable response caching
CACHE_ENABLED=true
CACHE_TTL=300

# Socket.IO Settings
SOCKET_PING_TIMEOUT=30000
SOCKET_PING_INTERVAL=25000

# ═══════════════════════════════════════════════════════════════════════════
# MONITORING & LOGGING
# ═══════════════════════════════════════════════════════════════════════════

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Enable request logging
REQUEST_LOGGING=true

# ═══════════════════════════════════════════════════════════════════════════
# 🎯 CAPACITY INFORMATION
# ═══════════════════════════════════════════════════════════════════════════
# Current Setup:
# - 3 Render Servers (FREE)
# - 3 MongoDB Databases (FREE M0)
# - Client-side Load Balancer
#
# Estimated Capacity:
# - 8,000-10,000 daily active users
# - 2,000-3,000 concurrent users per server
# - 6,000-9,000 total concurrent users
#
# Database Connections:
# - 80 connections per database
# - 240 total connections available
#
# Storage:
# - 1.5GB total (3 × 512MB)
#
# Cost: ₹0 (100% FREE)
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# WEB PUSH NOTIFICATIONS (VAPID Keys)
# Generate fresh keys with: node -e "import('web-push').then(wp => { const k = wp.default.generateVAPIDKeys(); console.log(k) })"
# ═══════════════════════════════════════════════════════════════════════════
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-email@gmail.com
